# Direct provider keys — use whichever you have.
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Portkey gateway (OpenAI-compatible). Optional. If a direct key above is missing,
# registered judges are routed through Portkey automatically; you can also name any
# model in your Portkey catalog directly, e.g. --judge @anthropic/claude-opus-5
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Catalog slugs used when falling back from a missing direct key (workspace-specific).
# PORTKEY_OPENAI_PROVIDER=@openai
# PORTKEY_GOOGLE_PROVIDER=@google
# For workspaces that pick the upstream via header instead of @slug/ prefixes,
# use --judge portkey:<model> together with:
# PORTKEY_PROVIDER=
